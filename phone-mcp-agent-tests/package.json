{
  "name": "phone-mcp-agent-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone Pi Agent SDK test harness for the PhoneMCP server",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "list": "tsx src/cli.ts list",
    "call": "tsx src/cli.ts call",
    "smoke": "tsx src/cli.ts smoke",
    "verify": "tsx src/cli.ts verify",
    "agent:smoke": "tsx src/agent-smoke.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "typebox": "1.3.10",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
